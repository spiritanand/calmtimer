#!/bin/bash
set -u

SELF="$0"
while [ -L "$SELF" ]; do
  l="$(readlink "$SELF")"
  case $l in /*) SELF=$l ;; *) SELF="$(dirname "$SELF")/$l" ;; esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
TIMERS="${CALMTIMER_STATE_DIR:-$HOME/Library/Application Support/calmtimer}/timers"
SOUND="$ROOT/sounds/ting.wav"
DEFAULT=3600

usage() {
  cat <<EOF
usage: calmtimer start [DURATION] [LABEL...]   DURATION: 60 (minutes), 1h30, 90s, 1.5h; quote spaced ones: "1h 30m"
       calmtimer cancel ID|all
       calmtimer list
EOF
}

seconds() {
  local s n='([0-9]+[.]?[0-9]*|[.][0-9]+)' h=0 m=0 x=0 re='[0-9.][[:space:]]+[0-9.]'
  # "10 3" is two numbers, not 103
  [[ $1 =~ $re ]] && return 1
  s="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
  [ -n "$s" ] || return 1
  re="^$n(h|hr|hrs|hour|hours)"
  if [[ $s =~ $re ]]; then h=${BASH_REMATCH[1]}; s=${s:${#BASH_REMATCH[0]}}; fi
  re="^$n(m|min|mins|minute|minutes)"
  if [[ $s =~ $re ]]; then
    m=${BASH_REMATCH[1]}; s=${s:${#BASH_REMATCH[0]}}
    re="^$n\$"
    if [[ $s =~ $re ]]; then x=$s; s=""; fi
  else
    re="^$n\$"
    if [[ $s =~ $re ]]; then m=$s; s=""; fi
  fi
  re="^$n(s|sec|secs|second|seconds)\$"
  if [[ $s =~ $re ]]; then x=${BASH_REMATCH[1]}; s=""; fi
  [ -z "$s" ] || return 1
  awk -v h="$h" -v m="$m" -v x="$x" 'BEGIN { t = int(h * 3600 + m * 60 + x + 0.5); if (t < 1 || t > 86400) exit 1; print t }'
}

human() {
  local t=$1 out=""
  [ "$t" -ge 3600 ] && out="$((t / 3600))h"
  [ $((t % 3600 / 60)) -gt 0 ] && out="$out${out:+ }$((t % 3600 / 60))m"
  [ $((t % 60)) -gt 0 ] && out="$out${out:+ }$((t % 60))s"
  echo "$out"
}

clock() { date -r "$1" "+%l:%M %p" | sed 's/^ //'; }

refresh() { open -g "swiftbar://refreshplugin?name=calmtimer" >/dev/null 2>&1 || true; }

start() {
  local raw=${1:-} rest label secs warn="" now end id k nbsp=$'\xc2\xa0'
  local -a w
  shift || true
  rest="$*"
  # Option+Space types a no-break space
  raw=${raw//$nbsp/ }
  rest=${rest//$nbsp/ }
  # Raycast users often type "60 tea" into the first field instead of tabbing to the label
  if [[ $rest != *[![:space:]]* ]] && [[ $raw = *[[:space:]]* ]] && ! seconds "$raw" >/dev/null; then
    read -r -a w <<<"$raw"
    for ((k = ${#w[@]} - 1; k >= 1; k--)); do
      # a bare number after a unit starts the label: "5 min 2 eggs"
      [ "$k" -gt 1 ] && [[ ${w[k-1]} = *[0-9.] ]] && continue
      if seconds "${w[*]:0:k}" >/dev/null; then raw="${w[*]:0:k}"; rest="${w[*]:k}"; break; fi
    done
  fi
  # SwiftBar treats "|" as its param separator, "\" as an escape and leading "-"/"~" as menu structure
  # shellcheck disable=SC1003
  label="$(printf '%s' "$rest" | tr -d '\000-\037|\\' | sed -e 's/^[-~[:space:]]*//' -e 's/[[:space:]]*$//')"
  if ! secs="$(seconds "$raw")"; then
    secs=$DEFAULT
    [[ $raw = *[![:space:]]* ]] && warn="⚠️ Couldn't read \"$raw\" · "
  fi
  now="$(date +%s)"
  end=$((now + secs))
  id="$now-$$"
  mkdir -p "$TIMERS" || { echo "calmtimer: can't create $TIMERS" >&2; exit 1; }
  printf '%s\n%s\n%s\n' "$end" "$secs" "$label" > "$TIMERS/$id"
  # own session so the launcher (Raycast, a terminal) can exit or be killed without taking the timer down
  perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$SELF" _run "$id" </dev/null >/dev/null 2>&1 &
  refresh
  echo "${warn}⏱ ${label:+$label · }$(human "$secs") · ends $(clock "$end")"
}

run() {
  local f="$TIMERS/$1" end secs label now left
  { read -r end && read -r secs && IFS= read -r label; } < "$f" 2>/dev/null || exit 0
  while [ -f "$f" ]; do
    now="$(date +%s)"
    left=$((end - now))
    [ "$left" -le 0 ] && break
    # short naps against the wall clock, so a timer that ends while the Mac sleeps fires right after wake
    sleep $((left < 5 ? left : 5))
  done
  rm "$f" 2>/dev/null || exit 0
  refresh
  osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' \
    "⏱ ${label:-Timer}" "$(human "$secs") timer is done" >/dev/null 2>&1 &
  afplay "$SOUND"
  sleep 0.2
  afplay "$SOUND"
}

list() {
  local f id end secs label now
  now="$(date +%s)"
  for f in "$TIMERS"/*; do
    [ -f "$f" ] || continue
    id=${f##*/}
    { read -r end && read -r secs && IFS= read -r label; } < "$f" 2>/dev/null || continue
    # its runner died (restart, logout, kill); the grace covers the moment between writing the file and spawning
    if [ $((now - ${id%%-*})) -gt 5 ] && ! pgrep -qf "calmtimer _run $id\$"; then
      rm -f "$f"
      continue
    fi
    printf '%s\t%s\t%s\t%s\n' "$end" "$secs" "$id" "$label"
  done | sort -n
}

cancel() {
  case ${1:-} in
    all) rm -f "$TIMERS"/*; refresh; echo "Cancelled all timers" ;;
    *[!0-9-]*|"") usage >&2; exit 2 ;;
    *)
      if rm "$TIMERS/$1" 2>/dev/null; then refresh; echo "Timer cancelled"; else echo "No such timer" >&2; exit 1; fi ;;
  esac
}

cmd=${1:-}
shift || true
case $cmd in
  start) start "$@" ;;
  cancel) cancel "$@" ;;
  list) list ;;
  _run) run "$1" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
